<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF10275E" android:endColor="#FF1F4FA8" android:angle="315" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" android:dashWidth="6dp" android:dashGap="6dp" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88E58A55" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
