<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF2A0E40" android:endColor="#FF4A1E6A" android:angle="270" />
            <stroke android:width="3dp" android:color="#FFE6C35C" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#AAE6C35C" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
