<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFF6E2C0" android:endColor="#FFE0B47A" android:angle="300" />
            <stroke android:width="3dp" android:color="#FFB06A2A" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="@dimen/widget_radius_inner" />
        </shape>
    </item>
</layer-list>
