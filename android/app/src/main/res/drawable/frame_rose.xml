<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFFBE3EA" android:endColor="#FFF0B6C8" android:angle="270" />
            <stroke android:width="2dp" android:color="#FFC0507A" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88FFFFFF" />
            <corners android:radius="@dimen/widget_radius_inner" />
        </shape>
    </item>
</layer-list>
