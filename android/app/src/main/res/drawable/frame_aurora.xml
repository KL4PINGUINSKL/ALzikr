<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF06121E" android:endColor="#FF1C3A4A" android:angle="270" />
            <stroke android:width="2dp" android:color="#CC3CE0A8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88C77DFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
