<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF05030F" android:endColor="#FF2A1650" android:angle="315" />
            <stroke android:width="2dp" android:color="#FFB9C6FF" android:dashWidth="1dp" android:dashGap="7dp" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#66F2D27A" />
            <corners android:radius="@dimen/widget_radius_inner" />
        </shape>
    </item>
</layer-list>
