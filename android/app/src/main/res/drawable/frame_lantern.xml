<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF1E1208" android:endColor="#FF5A3410" android:angle="270" />
            <stroke android:width="2dp" android:color="#FFF0A040" android:dashWidth="3dp" android:dashGap="5dp" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#55F5C35A" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
