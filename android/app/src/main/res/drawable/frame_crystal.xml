<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFEAF9FF" android:endColor="#FFBFE8F5" android:angle="300" />
            <stroke android:width="2dp" android:color="#FF5AB8D8" android:dashWidth="8dp" android:dashGap="4dp" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
