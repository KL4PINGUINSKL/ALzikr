<?xml version="1.0" encoding="utf-8"?>
<!-- Only RemoteViews-safe classes here (no plain View/Space). The friend fills the height; the text fills the width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/p_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:paddingStart="6dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="8dp"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <!-- The friend moves: the frames of its animation, flipped by the launcher (a widget cannot play Lottie). -->
        <ViewFlipper android:id="@+id/p_img" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="34"
            android:autoStart="true" android:flipInterval="90" android:contentDescription="صديقي" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="66"
            android:orientation="vertical" android:paddingStart="6dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/p_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/p_hearts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFE7C66B" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/p_say" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#FFFFFFFF" android:textSize="16sp" android:maxLines="3" android:ellipsize="end"
                android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/p_extra" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <!-- Two wide buttons that share the whole width. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"
        android:paddingStart="4dp">
        <TextView android:id="@+id/p_talk" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/widget_button"
            android:text="💬 كلّمني" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/p_tasbih" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/widget_button"
            android:text="📿 سبّح" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
